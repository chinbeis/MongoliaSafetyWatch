# Copy to .env (never commit .env). Placeholder values only.
#
# Required in production — the server refuses to start with a missing value,
# a value shorter than 32 characters, or one of the placeholders below.
# Generate with:  openssl rand -base64 48
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
COMMUNITY_CAPTCHA_SECRET=change-me-32-random-bytes
RATE_LIMIT_SALT_SECRET=change-me-32-random-bytes
ADMIN_TOKEN=change-me-long-random-string

# Optional — Cloudflare Turnstile. When both are set the community map uses
# Turnstile instead of the built-in math check.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Public site URL (used for canonical links, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://example.mn

# MapLibre style. Swap without a code change if the free tile host has trouble.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# Optional — error reporting. Leave empty to disable Sentry entirely.
SENTRY_DSN=

# Emergency switch: 1 = community map is read-only (no new pins, no flags).
COMMUNITY_REPORTS_READONLY=

# Attribution for the basemap above — change together with the style URL.
NEXT_PUBLIC_MAP_ATTRIBUTION=
